# ---------------------------------------------------------------------------
# wl-pulse configuration. Every variable has a sensible default; the app runs
# with an empty environment (SQLite + in-memory cache). Copy to `.env` and
# adjust as needed. All variables are prefixed WL_.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# SQLAlchemy async URL. Default is a zero-config local SQLite file.
# Production (docker-compose) uses PostgreSQL via asyncpg:
#   postgresql+asyncpg://wl:wl@db:5432/wl
WL_DATABASE_URL=sqlite+aiosqlite:///./data/wl.db

# --- Cache ------------------------------------------------------------------
# Backend selection: "auto" tries Redis and falls back to an in-process cache,
# "redis" requires Redis, "memory" never touches Redis.
WL_CACHE_BACKEND=auto
WL_REDIS_URL=redis://localhost:6379/0
# TTL for cached departure/disruption snapshots, in seconds. Should exceed the
# poll interval so a single slow cycle does not empty the cache.
WL_CACHE_TTL_SECONDS=180

# --- Poller / fair use ------------------------------------------------------
# Wiener Linien fair use requires >= 15 s between requests to the same feed.
# Values below 15 are clamped to 15 with a warning. Default: 30.
WL_POLL_INTERVAL_SECONDS=30
# Comma-separated station names to watch (matched case-insensitively against
# the station registry).
WL_WATCHED_STATIONS=Karlsplatz,Stephansplatz,Praterstern,Schwedenplatz
# Set to false to run an API-only instance (e.g. when scaling horizontally the
# poller should run in exactly one process).
WL_POLLER_ENABLED=true
# How many RBL/stop IDs are batched into one monitor request.
WL_MONITOR_MAX_RBLS_PER_REQUEST=25
# Max concurrent in-flight requests to the upstream API.
WL_MONITOR_CONCURRENCY=3
# On-demand watching: stations requested via the API join the poll set.
# Cap on how many such stations are watched at once (LRU eviction beyond it);
# 0 disables on-demand watching entirely.
WL_DYNAMIC_WATCH_MAX=25
# A dynamically watched station is dropped if nobody requested it for this long.
WL_DYNAMIC_WATCH_TTL_MINUTES=60

# --- Upstream HTTP ----------------------------------------------------------
WL_MONITOR_BASE_URL=https://www.wienerlinien.at/ogd_realtime
WL_HTTP_TIMEOUT_SECONDS=10
# Retries per request on transient failures (timeouts, 5xx), with exponential
# backoff and jitter between attempts.
WL_HTTP_MAX_RETRIES=2
WL_HTTP_BACKOFF_BASE_SECONDS=0.5

# --- Circuit breaker --------------------------------------------------------
# After this many consecutive failed poll cycles the breaker opens ...
WL_CB_FAILURE_THRESHOLD=5
# ... and polling pauses for this cooldown before a half-open probe.
WL_CB_COOLDOWN_SECONDS=120

# --- History / stats --------------------------------------------------------
# Departure snapshots older than this are deleted by the poller.
WL_SNAPSHOT_RETENTION_MINUTES=180
# At most this many upcoming departures per line/stop are persisted per cycle.
WL_SNAPSHOT_MAX_DEPARTURES_PER_LINE=4
# A departure counts as on time if it leaves at most this many seconds late
# (and at most 60 s early).
WL_STATS_ON_TIME_THRESHOLD_SECONDS=120

# --- Registry ---------------------------------------------------------------
# Directory containing the four wienerlinien-ogd-*.csv registry files.
WL_DATA_DIR=./data
# If true and the registry tables are empty and the CSVs are missing, they are
# downloaded once from wienerlinien.at at startup.
WL_REGISTRY_AUTO_DOWNLOAD=true

# --- API --------------------------------------------------------------------
# Per-client-IP request budget per minute (sliding window). /health and the
# OpenAPI docs are exempt.
WL_RATE_LIMIT_PER_MINUTE=120

# --- Logging ----------------------------------------------------------------
WL_LOG_LEVEL=INFO
# true = one JSON object per line (production), false = human-readable (dev).
WL_LOG_JSON=true
